{
  "name": "agentic-test-runner",
  "version": "0.4.1",
  "description": "LLM-judged CLI test runner — define test cases in YAML, execute commands, let an LLM judge PASS/FAIL. Outputs JSONL trace.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "atest": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "testing",
    "cli",
    "test-runner",
    "yaml",
    "ai-judge",
    "agentic",
    "automation"
  ],
  "author": "Scott Wei <xiaomooo@shazhou.work>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "help/",
    "README.md",
    "examples/",
    "LICENSE"
  ],
  "dependencies": {
    "jsonata": "^2.2.2",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
